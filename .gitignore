# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Local config overrides — keep config.yaml as the template,
# but let users keep a private one with their offsets.
config.local.yaml
*.local.yaml

# Pokémon save / ROM artifacts (never commit these)
*.sav
*.bin
*.3ds
*.cia
*.cci
*.cxi
*.nds

# Offset-finder dumps
offsets_*.txt
ram_dump_*.bin

# Durable event log written by pokebot.event_log (logs/ is ignored
# above). last_events.log is a leftover from the removed websocket
# dashboard — nothing writes it any more.
last_events.log
*.jsonl

# Accessor-address cache (per-game, written by observe mode)
.pokebot_accessors.json

# Discovered Crystal WRAM base (per-install, re-validated on use)
.crystal_wram.json

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Caught-Pokemon exports (user save data — never commit)
targets/
*.pk6
*.pk7
*.ek6
*.ek7

# Per-run bot statistics and scratch diagnostics
.pokebot_stats.json
check_bounds.txt

# Update machinery: BUILD_INFO.json is stamped by CI into the release
# zip, and .update-backup/ holds the files an in-place update replaced.
BUILD_INFO.json
.update-backup/
